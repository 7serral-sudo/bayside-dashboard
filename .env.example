# Cloudbeds API
CLOUDBEDS_API_KEY=cbat_your_api_key_here
CLOUDBEDS_PROPERTY_ID=your_property_id_here

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Optional: email alert on failure
ALERT_EMAIL=your_email@example.com

# Google Places API -- live Google rating + review count for the dashboard.
# Enable "Places API (New)" in Google Cloud, create an API key, and restrict it
# to that API. GOOGLE_PLACE_ID is the Place ID for Bayside House -- find it at
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=your_places_api_key_here
GOOGLE_PLACE_ID=your_place_id_here

# SerpApi -- live Booking.com and Expedia ratings. Both block direct reads, so
# we take the figures from Google's search results instead. Sign up free at
# https://serpapi.com/users/sign_up (no card); the weekly run uses ~8 searches
# a month, well inside the free allowance. Key is on your SerpApi dashboard.
SERPAPI_KEY=your_serpapi_key_here

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=paste_your_long_lived_token_here
INSTAGRAM_APP_ID=paste_your_app_id_here
INSTAGRAM_APP_SECRET=paste_your_app_secret_here
